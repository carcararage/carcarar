# Copie para .env.local e preencha (Supabase → Project Settings → API).
# Sem estas duas linhas o app roda em MODO DEMONSTRAÇÃO (dados só no navegador, sem login).
VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Opcional: fundo do mapa com chave própria (ex.: MapTiler)
# VITE_MAP_TILES=https://api.maptiler.com/maps/streets-v2/{z}/{x}/{y}.png?key=SUA_CHAVE
# VITE_MAP_ATTRIBUTION=&copy; MapTiler &copy; OpenStreetMap
