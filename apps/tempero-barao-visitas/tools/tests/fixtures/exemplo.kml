<?xml version="1.0" encoding="UTF-8"?>
<!-- Arquivo FICTÍCIO de teste: nomes, telefones e endereços inventados. -->
<kml xmlns="http://www.opengis.net/kml/2.2">
<Document>
  <name>Pontos Exemplo</name>

  <Folder>
    <name>Parnaíba</name>

    <Folder>
      <name>Restaurantes</name>
      <Placemark>
        <name>Restaurante Exemplo 1</name>
        <description><![CDATA[<b>Fone:</b> (86) 90000-0001<br>Rua Fictícia, 100]]></description>
        <Point><coordinates>-41.7760,-2.9050,0</coordinates></Point>
      </Placemark>
      <Placemark>
        <name>Restaurante Exemplo 2</name>
        <ExtendedData>
          <Data name="Telefone"><value>86 90000-0002</value></Data>
          <Data name="Endereço"><value>Av. Fictícia, 200</value></Data>
          <Data name="Bairro"><value>Centro</value></Data>
          <Data name="Obs"><value>Fecha às segundas</value></Data>
        </ExtendedData>
        <Point><coordinates>-41.7800,-2.9100,0</coordinates></Point>
      </Placemark>
      <!-- duplicado exato do Exemplo 1 -->
      <Placemark>
        <name>Restaurante Exemplo 1</name>
        <Point><coordinates>-41.7760,-2.9050,0</coordinates></Point>
      </Placemark>
    </Folder>

    <Folder>
      <name>Mercados</name>
      <Placemark>
        <name>Mercadinho São José</name>
        <Point><coordinates>-41.7750,-2.9150,0</coordinates></Point>
      </Placemark>
      <!-- mesmo ponto, só muda acento/caixa: deve contar como duplicado -->
      <Placemark>
        <name>MERCADINHO SAO JOSE</name>
        <Point><coordinates>-41.7750,-2.9150,0</coordinates></Point>
      </Placemark>
      <!-- fora de qualquer região -->
      <Placemark>
        <name>Mercado Distante</name>
        <Point><coordinates>-41.7000,-2.9500,0</coordinates></Point>
      </Placemark>
    </Folder>
  </Folder>

  <Placemark>
    <name>Lanchonete Sem Pasta</name>
    <Point><coordinates>-41.7780,-2.9120,0</coordinates></Point>
  </Placemark>

  <!-- rota desenhada: ignorada -->
  <Placemark>
    <name>Rota Centro</name>
    <LineString><coordinates>-41.78,-2.91,0 -41.77,-2.91,0</coordinates></LineString>
  </Placemark>

  <!-- sem geometria -->
  <Placemark><name>Anotação solta</name></Placemark>

  <!-- latitude impossível (provável troca lat/lng) -->
  <Placemark>
    <name>Coordenada Inválida</name>
    <Point><coordinates>-41.7,-95.0,0</coordinates></Point>
  </Placemark>

  <!-- território -->
  <Placemark>
    <name>Região Centro</name>
    <Polygon>
      <outerBoundaryIs><LinearRing><coordinates>
        -41.790,-2.900,0 -41.770,-2.900,0 -41.770,-2.920,0 -41.790,-2.920,0 -41.790,-2.900,0
      </coordinates></LinearRing></outerBoundaryIs>
    </Polygon>
  </Placemark>
</Document>
</kml>
